# --- Server ---
PORT=4000
# JWT-Signaturschluessel — in Produktion zwingend ersetzen (langer Zufallswert)
JWT_SECRET=change-me-in-production
# Pfad fuer die Datenpersistenz (Boards, Nutzer, Yjs-Snapshots)
DATA_DIR=./data
# Erlaubte Origin(s) des Web-Clients
CORS_ORIGIN=http://localhost:5173

# --- Web (Vite) ---
# Basis-URL der API / des Sync-Servers (vom Browser aus erreichbar)
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
